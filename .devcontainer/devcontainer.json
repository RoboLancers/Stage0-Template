// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/java
{
	"name": "Java",
	// The Java image plus the reload helper (see Dockerfile).
	"build": { "dockerfile": "Dockerfile" },

	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": "false",
			"installGradle": "true"
		},
		// The FRC Mentor plugin's edit guard and notes server run on Node.
		// Without Node, Copilot blocks every tool call while the plugin is on.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},

	// Keep the Copilot CLI and its plugins across rebuilds.
	"mounts": [
		"source=stage0-copilot,target=/home/vscode/.copilot,type=volume"
	],

	"containerEnv": {
		"COPILOT_AUTO_UPDATE": "false"
	},

	// Installs the Copilot CLI and the FRC Mentor plugin (copilot-port branch).
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.copilot && bash .devcontainer/install-frc-mentor.sh",

	// Reloads the window once setup is done, so Copilot Chat loads the newly cloned plugin.
	"postAttachCommand": "bash .devcontainer/post-attach.sh",

	"customizations": {
		// In Codespaces, ask for read access to the private frc-mentor repo so the script can clone it.
		"codespaces": {
			"repositories": {
				"RoboLancers/frc-mentor": {
					"permissions": {
						"contents": "read"
					}
				}
			}
		},
		"vscode": {
			// Load the FRC Mentor plugin into Copilot Chat from the copy the install script clones.
			// Set as a container (machine) setting, so it isn't in a repo file students edit.
			"settings": {
				"chat.plugins.enabled": true,
				"chat.pluginLocations": {
					"/home/vscode/frc-mentor/plugins/frc-mentor": true
				},
				// Start every new chat in the mentor agent. VS Code can't hide the built-in
				// agents, so students can still switch away in the dropdown.
				// Must match the agent's header name in the plugin's agents/mentor.md exactly.
				"chat.newSession.defaultMode": "mentor"
			},
			"extensions": [
				"GitHub.copilot-chat"
			]
		}
	}

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
